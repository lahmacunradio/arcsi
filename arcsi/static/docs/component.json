{
  "components": {
    "schemas": {
      "date": {
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "example": 2022
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "example": 12
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "example": 21
          }
        }
      },
      "id": {
        "type": "integer",
        "format": "int32",
        "example": 1
      },
      "url": {
        "type": "string",
        "example": "https://www.lahmacun.hu"
      },
      "apiToken": {
        "type": "object",
        "properties": {
          "api_token": {
            "type": "string"
          }
        }
      },
      "timeFrame": {
        "properties": {
          "start_date": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/date"
            }
          },
          "end_date": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/date"
            }
          }
        }
      },
      "show": {
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "show-name"
          },
          "archive_lahmastore_base_url": {
            "type": "string",
            "example": "show-archive_lahmastore_base_url"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      }
    }
  }
}