  "paths": {
    "/data/uploaded_episodes": {
      "post": {
        "tags": [
          "Data Request"
        ],
        "summary": "Returns the number of uploaded episodes during the given timeframe",
        "security": [
          {
            "AdminApiKeyAuth": []
          }
        ],
        "consumes": [
          "multipart/form-data"
        ],
        "requestBody": {
          "schema": {
            "$ref": "component.json#/components/schemas/timeFrame"
          }
        },
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "type": "object",
                "properties": {
                  "uploaded_episodes_between_start_date_end_date": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Please, be postive!"
          },
          "418": {
            "description": "Back to the future?"
          }
        }
      }
    },
    "/data/weekly_schedule": {
      "get": {
        "tags": [
          "Data Request"
        ],
        "summary": "Return weekly schedule playlist data for Liquidsoap",
        "security": [
          {
            "AdminApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "week",
            "required": false,
            "description": "week number, default: current week",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "type": "object",
                "properties": {
                  "playlist_init": {
                    "type": "string"
                  },
                  "playlist_schedule": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/get_api_token": {
      "post": {
        "tags": [
          "User Request"
        ],
        "summary": "Return API token for given User",
        "consumes": [
