  "components": {
    "securitySchemes": {
      "GuestApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authentication-Token"
      },
      "AdminApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authentication-Token"
      }
    }
  },
  "servers": [
    {
      "url": "/arcsi/"
    }
  ],
  "tags": [
    {
      "name": "User Request",
      "description": "API for requesting and return User details"
    },
    {
      "name": "Show Requests for external usage",
      "description": "API for requesting and return Show details"
    },
    {
      "name": "Item Requests for external usage",
      "description": "API for requesting and return Item details"
    },
    {
      "name": "Tag Requests for external usage",
      "description": "API for requesting and return Tag details"
    },
    {
      "name": "Show Requests for Archon",
      "description": "API for requesting and return Show details"
    },
    {
      "name": "Item Requests for Archon",
      "description": "API for requesting and return Item details"
    },
    {
      "name": "Data Request",
      "description": "API for requesting and return Data"
    }
