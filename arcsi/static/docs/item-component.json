{
  "components": {
    "schemas": {
      "ItemRequestSchema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32",
            "example": 42
          },
          "name": {
            "type": "string",
            "example": "item-name"
          },
          "description": {
            "type": "string",
            "example": "item-description"
          },
          "language": {
            "type": "string",
            "example": "item-language"
          },
          "play_date": {
            "type": "string",
            "format": "date",
            "example": "2001-09-11"
          },
          "live": {
            "type": "boolean",
            "example": true
          },
          "broadcast": {
            "type": "boolean",
            "example": true
          },
          "archive_lahmastore": {
            "type": "boolean",
            "example": true
          },
          "external_url": {
            "type": "string",
            "example": "item-external_url"
          },
          "uploader": {
            "type": "string",
            "example": "item-uploader"
          },
          "shows": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "show_name": {
            "type": "string",
            "example": "item-show_name"
